# ─────────────────────────────────────────────
#  BBC Barrel Track — Variables de entorno
#  Copia este archivo a .env y ajusta los valores
# ─────────────────────────────────────────────

# ── PostgreSQL (Docker) ──────────────────────
POSTGRES_USER=bbc
POSTGRES_PASSWORD=bbc_secret
POSTGRES_DB=bbc_barrel_track

# ── API (apps/api) ───────────────────────────
DATABASE_URL=postgresql://bbc:bbc_secret@localhost:5432/bbc_barrel_track
PORT=4000
NODE_ENV=development

# JWT — cambia los secrets en producción
JWT_SECRET=change_me_in_production_api_secret_32chars
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — origen permitido (web)
CORS_ORIGIN=http://localhost:3000

# ── Web (apps/web) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── pgAdmin ──────────────────────────────────
PGADMIN_EMAIL=admin@bbc.local
PGADMIN_PASSWORD=admin
